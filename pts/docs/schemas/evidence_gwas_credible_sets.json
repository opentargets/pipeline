{
  "name": "evidence_gwas_credible_sets",
  "description": "GWAS credible-set locus-to-gene evidence",
  "primary_key": [
    "id"
  ],
  "strict": true,
  "fields": [
    {
      "name": "diseaseFromSourceMappedId",
      "description": "Mapped Open Targets disease identifier",
      "required": true,
      "nullable": false,
      "type": "String",
      "constraints": {
        "pattern": "^[A-Za-z]+_[A-Za-z0-9]+$"
      }
    },
    {
      "name": "diseaseId",
      "description": "Open Targets disease identifier",
      "required": true,
      "nullable": false,
      "type": "String",
      "constraints": {
        "pattern": "^[A-Za-z]+_[A-Za-z0-9]+$"
      },
      "reference": {
        "dataset": "disease",
        "column": "id"
      }
    },
    {
      "name": "targetId",
      "description": "Open Targets target identifier",
      "required": true,
      "nullable": false,
      "type": "String",
      "constraints": {
        "pattern": "^ENSG\\d{11}$"
      },
      "reference": {
        "dataset": "target",
        "column": "id"
      },
      "bioregistry": "ensembl"
    },
    {
      "name": "id",
      "description": "Identifer of the disease/target evidence",
      "required": true,
      "primary_key": true,
      "nullable": false,
      "type": "String",
      "constraints": {
        "pattern": "^[0-9a-f]{40}$"
      }
    },
    {
      "name": "qualityControls",
      "description": "Evidence quality flags",
      "required": true,
      "nullable": false,
      "type": {
        "type": "list",
        "element": {
          "nullable": false,
          "type": "String",
          "constraints": {
            "allowed": [
              "No valid disease",
              "No valid target",
              "Duplicated",
              "No valid score",
              "Invalid biotype"
            ]
          }
        }
      }
    },
    {
      "name": "score",
      "description": "Score of the evidence reflecting the strength of the disease/target relationship",
      "required": true,
      "nullable": false,
      "type": "Float64",
      "constraints": {
        "ge": 0.0,
        "le": 1.0
      }
    },
    {
      "name": "datatypeId",
      "description": "Type of the evidence",
      "required": true,
      "note": "constant for this datasource; not an enum in the shared evidence spec",
      "nullable": false,
      "type": "String",
      "constraints": {
        "allowed": [
          "genetic_association"
        ]
      }
    },
    {
      "name": "datasourceId",
      "description": "Identifer of the evidence source",
      "required": true,
      "nullable": false,
      "type": "String",
      "constraints": {
        "allowed": [
          "gwas_credible_sets"
        ]
      }
    },
    {
      "name": "targetFromSourceId",
      "description": "Target ID in resource of origin (accepted sources include Ensembl gene ID, Uniprot ID, gene symbol), only capital letters are accepted",
      "required": true,
      "nullable": false,
      "type": "String",
      "constraints": {
        "pattern": "^ENSG\\d{11}$"
      }
    },
    {
      "name": "resourceScore",
      "description": "Score provided by datasource indicating strength of target-disease association",
      "required": true,
      "nullable": false,
      "type": "Float64",
      "constraints": {
        "ge": 0.0,
        "le": 1.0
      }
    },
    {
      "name": "curationDate",
      "description": "Date of the GWAS study curation",
      "required": true,
      "nullable": true,
      "type": "String",
      "constraints": {
        "pattern": "\\d{4}-\\d{2}-\\d{2}"
      }
    },
    {
      "name": "studyLocusId",
      "description": "Identifier of the Open Targets Study Locus",
      "required": true,
      "nullable": false,
      "type": "String",
      "reference": {
        "dataset": "credible_set",
        "column": "studyLocusId"
      }
    },
    {
      "name": "literature",
      "description": "List of PubMed or preprint reference identifiers",
      "required": true,
      "note": "digits-only (PMID) for this datasource; other sources may carry PPR/AGR ids",
      "nullable": true,
      "type": {
        "type": "list",
        "element": {
          "nullable": false,
          "type": "String",
          "constraints": {
            "pattern": "^\\d+$"
          }
        }
      }
    },
    {
      "name": "publicationDate",
      "description": "Date of the earliest publication supporting the evidence",
      "required": true,
      "nullable": true,
      "type": "String",
      "constraints": {
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      }
    },
    {
      "name": "evidenceDate",
      "description": "Earliest data for the evidence",
      "required": true,
      "nullable": true,
      "type": "String"
    }
  ],
  "checks": [],
  "example": {
    "diseaseFromSourceMappedId": "EFO_0004340",
    "diseaseId": "EFO_0004340",
    "targetId": "ENSG00000169174",
    "id": "3f2b1c9e8d7a6b5c4d3e2f1a0b9c8d7e6f5a4b3c",
    "qualityControls": [
      "Duplicated"
    ],
    "score": 0.87,
    "datatypeId": "genetic_association",
    "datasourceId": "gwas_credible_sets",
    "targetFromSourceId": "ENSG00000169174",
    "resourceScore": 0.87,
    "curationDate": "2019-10-04",
    "studyLocusId": "0a1b2c3d4e5f60718293a4b5c6d7e8f9",
    "literature": [
      "31578528"
    ],
    "publicationDate": "2019-10-04",
    "evidenceDate": "2019-10-04"
  }
}
